; '}' directly after the last operand (no whitespace) is accepted.
; C-only behaviour: the Python reference reports missing-whitespace here,
; so the expected files were NOT generated by tools/make_golden.sh.
        MOV (PC)+, R1
HERO_CLEAR_BUFFER_ADDR:    .WORD 0
        MOV (R1), R0
        BEQ 1
        CLR (R1)+
        MOV #100 - 4, R3
    0:    .REPEAT 20 {
            .REPEAT 3 {MOV (R1)+, (R0)+}
            ADD R3, R0
        }
    1:    RET
        .REPEAT 2 { .WORD 1}
